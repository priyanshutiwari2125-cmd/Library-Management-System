<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="LibraryManagementSystem.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Library Management System</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome 6 CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

    <!-- DataTables CSS & Buttons Extension -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet" />

    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/CSS/style.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <!-- Loading Spinner -->
        <div id="loadingSpinner">
            <div class="spinner-border text-light mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h6 class="fw-semibold text-white">Processing Request...</h6>
        </div>

        <div id="wrapper">
            <!-- Sidebar Navigation -->
            <nav id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-brand-icon">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </div>
                    <div>
                        <div class="sidebar-brand-text">LibraryOS</div>
                        <div class="sidebar-brand-sub">Management Suite</div>
                    </div>
                </div>

                <ul class="sidebar-menu">
                    <li class="sidebar-label">Main Navigation</li>
                    <li id="navDashboard" runat="server">
                        <a href="Dashboard.aspx">
                            <i class="fa-solid fa-chart-pie"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="sidebar-label">Core Operations</li>
                    <li id="navBooks" runat="server">
                        <a href="Books.aspx">
                            <i class="fa-solid fa-book"></i>
                            <span>Manage Books</span>
                        </a>
                    </li>
                    <li id="navStudents" runat="server">
                        <a href="Students.aspx">
                            <i class="fa-solid fa-user-graduate"></i>
                            <span>Manage Students</span>
                        </a>
                    </li>
                    <li id="navIssue" runat="server">
                        <a href="IssueBook.aspx">
                            <i class="fa-solid fa-hand-holding-hand"></i>
                            <span>Issue Book</span>
                        </a>
                    </li>
                    <li id="navReturn" runat="server">
                        <a href="ReturnBook.aspx">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>Return Book</span>
                        </a>
                    </li>

                    <li class="sidebar-label">Analytics & Reports</li>
                    <li id="navReports" runat="server">
                        <a href="Reports.aspx">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            <span>Reports & Fines</span>
                        </a>
                    </li>

                    <li class="sidebar-label">Account</li>
                    <li>
                        <asp:LinkButton ID="btnSidebarLogout" runat="server" OnClick="btnLogout_Click" CauseValidation="false">
                            <i class="fa-solid fa-right-from-bracket text-danger"></i>
                            <span class="text-danger fw-semibold">Sign Out</span>
                        </asp:LinkButton>
                    </li>
                </ul>

                <div class="p-3 text-center border-top border-secondary border-opacity-25 mt-auto">
                    <small class="text-muted d-block">&copy; <%: DateTime.Now.Year %> LibraryOS v2.5</small>
                    <small class="text-muted">Production Build</small>
                </div>
            </nav>

            <!-- Page Content -->
            <div id="content">
                <!-- Top Navbar -->
                <nav class="navbar navbar-expand navbar-custom sticky-top">
                    <div class="container-fluid px-0">
                        <button type="button" id="sidebarToggle" class="toggle-btn me-3" title="Toggle Sidebar">
                            <i class="fa-solid fa-bars-staggered"></i>
                        </button>

                        <div class="d-none d-md-flex align-items-center me-auto">
                            <span class="text-muted small me-2"><i class="fa-regular fa-clock me-1"></i> System Time:</span>
                            <span class="fw-medium text-dark small"><%: DateTime.Now.ToString("dd MMM yyyy, dddd") %></span>
                        </div>

                        <!-- Right Profile Dropdown -->
                        <div class="dropdown ms-auto">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar me-2">
                                    <asp:Literal ID="litAdminInitial" runat="server">A</asp:Literal>
                                </div>
                                <div class="d-none d-sm-block text-start me-2">
                                    <div class="fw-bold text-dark lh-1 mb-1">
                                        <asp:Literal ID="litAdminName" runat="server">Administrator</asp:Literal>
                                    </div>
                                    <small class="text-muted lh-1">Super Admin</small>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userDropdown">
                                <li class="px-3 py-2 border-bottom">
                                    <p class="mb-0 text-muted small">Signed in as</p>
                                    <p class="mb-0 fw-bold text-dark small"><asp:Literal ID="litAdminEmail" runat="server">admin@library.com</asp:Literal></p>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="Dashboard.aspx"><i class="fa-solid fa-sliders me-2 text-primary"></i> Dashboard</a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="dropdown-item text-danger py-2" OnClick="btnLogout_Click" CauseValidation="false">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                    </asp:LinkButton>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!-- Main Body Content -->
                <div class="container-fluid p-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
    </form>

    <!-- jQuery & Bootstrap 5 JS Bundle -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JS & Extensions -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom App JS -->
    <script src="JS/main.js"></script>

    <asp:ContentPlaceHolder ID="ScriptContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
